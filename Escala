align-items:center;
color:#159578;
font-size:9px;
margin-bottom:6px;
white-space:nowrap;
}

.welcome-dot{
width:5px;
height:5px;
margin:0 5px;
border-radius:50%;
background:#159578;
}

.updated{
color:#7f8a97;
}

.title{
font-size:18px;
line-height:1;
font-weight:750;
letter-spacing:-.3px;
margin-bottom:9px;
}

.currencies{
display:flex;
flex-wrap:wrap;
gap:3px;
margin-bottom:7px;
}

.currency{
padding:3px 7px;
border-radius:10px;
background:rgba(126,143,161,.18);
color:#9ea9b4;
font-size:8px;
font-weight:700;
}

.currency.active{
background:#168d73;
color:#e7f2ef;
}

.balance-label{
color:#84909d;
font-size:9px;
margin-bottom:2px;
}

.balance-row{
display:flex;
align-items:center;
justify-content:space-between;
gap:5px;
}

.balance{
display:flex;
align-items:center;
white-space:nowrap;
font-size:23px;
line-height:1;
font-weight:750;
letter-spacing:-.5px;
}

.currency-symbol{
color:#7e8b99;
font-size:10px;
font-weight:600;
margin-right:3px;
}

.eye{
width:14px;
height:8px;
margin-left:5px;
border:1.5px solid #68798b;
border-radius:70% 20%;
transform:rotate(45deg);
position:relative;
}

.eye::after{
content:"";
position:absolute;
width:3px;
height:3px;
border:1px solid #68798b;
border-radius:50%;
top:1px;
left:4px;
}

.report{
height:34px;
min-width:105px;
padding:0 8px;
border-radius:10px;
background:#168d73;
color:#e9f4f1;
font-size:9px;
font-weight:750;
}

.card-bottom{
position:absolute;
left:16px;
right:16px;
bottom:11px;
display:grid;
grid-template-columns:1fr 1fr 1fr;
}

.card-stat{
min-height:30px;
padding-left:8px;
border-left:1px solid rgba(255,255,255,.08);
}

.card-stat:first-child{
border-left:0;
padding-left:0;
}

.card-stat-label{
color:#7f8c9b;
font-size:7px;
margin-bottom:3px;
letter-spacing:.3px;
}

.card-stat-value{
color:#c2ccd6;
font-size:12px;
font-weight:700;
}

.card-stat-value.green{
color:#159578;
}

.banner{
width:100%;
height:190px;
margin:9px auto 0;
position:relative;
overflow:hidden;
border-radius:16px;
background:
radial-gradient(circle at 18% 55%,#173a48 0,#173a48 22%,transparent 23%),
radial-gradient(circle at 82% 38%,#162f49 0,#162f49 24%,transparent 25%),
linear-gradient(135deg,#102d3d,#172f49);
}

.banner-tag{
position:absolute;
z-index:5;
top:9px;
left:9px;
padding:4px 7px;
border-radius:9px;
background:rgba(78,88,98,.43);
border:1px solid rgba(255,255,255,.10);
color:#d4dbe1;
font-size:7px;
letter-spacing:1px;
font-weight:700;
}

.fullscreen{
position:absolute;
top:8px;
right:8px;
z-index:6;
width:27px;
height:27px;
border-radius:50%;
background:rgba(60,69,78,.48);
color:#d8dee4;
font-size:12px;
}

.referral-label{
position:absolute;
top:30px;
left:50%;
