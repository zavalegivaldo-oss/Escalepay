}

.person::after{
content:"";
position:absolute;
width:17px;
height:6px;
left:6px;
bottom:4px;
border-radius:20px 20px 0 0;
background:#168d73;
}

.banner-center{
position:absolute;
top:78px;
left:0;
right:0;
z-index:5;
text-align:center;
}

.banner-center-title{
color:#d4dbe1;
font-size:13px;
font-weight:750;
margin-bottom:3px;
}

.banner-center-text{
color:#8794a1;
font-size:8px;
line-height:1.3;
}

.video{
position:absolute;
z-index:9;
left:50%;
top:50%;
