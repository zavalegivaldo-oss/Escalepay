<script>

const editableElements =
document.querySelectorAll(".editable");

editableElements.forEach(element => {

const key =
element.dataset.key;

const savedValue =
localStorage.getItem(
"escalePay_" + key
);

if(savedValue !== null){

element.textContent =
savedValue;

}

element.addEventListener(
"click",
function(){

if(
this.querySelector("input")
) return;

const oldValue =
this.textContent.trim();

const input =
document.createElement("input");

input.type = "text";

input.className =
"editable-input";

input.value =
oldValue;

this.textContent = "";

this.appendChild(input);

input.focus();
input.select();

function save(){

let value =
input.value.trim();

if(value === ""){

value =
oldValue;

}

localStorage.setItem(
"escalePay_" + key,
value
);

element.textContent =
value;

}

input.addEventListener(
"blur",
save
);

input.addEventListener(
"keydown",
function(event){

if(event.key === "Enter"){

input.blur();

}

if(event.key === "Escape"){

element.textContent =
oldValue;

}

}
);

