);

});

/* IMAGEM DO BANNER */

const videoButton =
document.getElementById(
"videoButton"
);

const imageInput =
document.getElementById(
"videoImageInput"
);

const banner =
document.querySelector(
".banner"
);

videoButton.addEventListener(
"click",
function(){

imageInput.click();

}
);

imageInput.addEventListener(
"change",
function(){

const file =
this.files[0];

if(!file) return;

if(
!file.type.startsWith("image/")
) return;

const imageURL =
URL.createObjectURL(file);

let image =
document.getElementById(
"temporaryBannerImage"
);

if(!image){

image =
document.createElement("img");

image.id =
"temporaryBannerImage";

banner.insertBefore(
image,
banner.firstChild
);

}

image.src =
imageURL;

}
);

</script>

