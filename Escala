}

.chat-icon::after{
content:"";
position:absolute;
left:5px;
bottom:-5px;
border-style:solid;
border-width:5px 5px 0 0;
border-color:#f5f7f9 transparent transparent transparent;
}

.editable{
cursor:pointer;
transition:opacity .15s ease;
}

.editable:active{
opacity:.55;
}

.editable-input{
font-family:inherit;
border:0;
outline:0;
