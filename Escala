<style>
*{
box-sizing:border-box;
margin:0;
padding:0;
}

:root{
--bg:#f5f6f7;
--white:#fff;
--text:#253446;
--text-dark:#1d2c3d;
--muted:#9aa2aa;
--muted-dark:#818b96;
--line:#e8ebee;
--green:#0aa47f;
--green-dark:#087e66;
--green-soft:#edf7f4;
--blue:#4b7fbd;
--blue-soft:#f0f4f9;
--red:#bd6477;
--red-soft:#faf0f2;
--navy:#172c45;
--navy-2:#1a344b;
}

html,body{
width:100%;
min-height:100%;
}

body{
background:var(--bg);
color:var(--text);
font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
overflow-x:hidden;
}

button{
font-family:inherit;
border:0;
outline:none;
cursor:pointer;
}

.app{
width:100%;
max-width:430px;
margin:0 auto;
padding:6px 9px 35px;
}

.topbar{
width:100%;
height:44px;
display:flex;
align-items:center;
gap:5px;
margin-bottom:9px;
}

.menu{
width:41px;
height:41px;
flex:none;
border-radius:12px;
background:#fff;
border:1px solid var(--line);
display:flex;
align-items:center;
justify-content:center;
}

.menu-lines,
.menu-lines::before,
.menu-lines::after{
width:17px;
height:2px;
background:#536272;
border-radius:3px;
display:block;
position:relative;
}

.menu-lines::before,
.menu-lines::after{
content:"";
position:absolute;
left:0;
}

.menu-lines::before{top:-5px;}
.menu-lines::after{top:5px;}

.avatar{
width:41px;
height:41px;
flex:none;
border-radius:50%;
background:#168d73;
color:#f4f7f6;
display:flex;
align-items:center;
justify-content:center;
font-size:11px;
font-weight:800;
}

.products{
flex:1;
min-width:0;
height:41px;
background:#fff;
border:1px solid var(--line);
border-radius:12px;
display:flex;
align-items:center;
gap:5px;
padding:0 9px;
color:#4a5969;
font-size:10px;
font-weight:600;
white-space:nowrap;
}

.products-icon{
font-size:12px;
color:#8994a0;
}

.arrow{
margin-left:auto;
color:#929ba5;
font-size:13px;
}

.period{
width:74px;
height:41px;
flex:none;
